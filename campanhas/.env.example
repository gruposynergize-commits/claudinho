# =====================================================================
# Variáveis de ambiente — copie para .env e preencha.
# NUNCA versione o arquivo .env nem coloque credenciais reais aqui.
# =====================================================================

# --- Banco de dados (PostgreSQL 14+) ---------------------------------
DATABASE_URL=postgresql://usuario:senha@localhost:5432/campanhas
# Tamanho máximo do pool de conexões por processo.
DATABASE_POOL_MAX=10

# --- Aplicação ---------------------------------------------------------
# URL pública (HTTPS em produção). Usada para links, webhook e checagem de Origin.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Segredo com pelo menos 32 caracteres aleatórios (ex.: `openssl rand -base64 48`).
# Usado para HMAC de identificadores (IP, CPF) e derivação de chaves.
AUTH_SECRET=
# Opcional: chave AES-256-GCM (32 bytes em base64) para criptografar CPF e
# credenciais salvas pelo painel. Se vazia, é derivada do AUTH_SECRET.
DATA_ENCRYPTION_KEY=
# "true" somente se a aplicação estiver atrás de um proxy confiável
# (Nginx, Vercel, Cloudflare) que define X-Forwarded-For.
TRUST_PROXY=false
# Segredo exigido pelos endpoints /api/cron/* (Authorization: Bearer <CRON_SECRET>).
CRON_SECRET=

# --- Pagamento: Mercado Pago -----------------------------------------
# "mercadopago" para cobranças Pix automáticas. Vazio = somente Pix manual (estático).
PAYMENT_GATEWAY=mercadopago
# Access Token do Mercado Pago (Suas integrações > Credenciais). Somente backend.
PAYMENT_API_KEY=
# Assinatura secreta dos webhooks (Suas integrações > Webhooks > Assinatura secreta).
PAYMENT_WEBHOOK_SECRET=
# Não altere em produção. Usado apenas para apontar para o simulador local.
MERCADOPAGO_API_BASE_URL=https://api.mercadopago.com
# Validade mínima aceita pelo gateway para cobranças Pix (minutos).
MERCADOPAGO_PIX_MIN_EXPIRATION_MINUTES=30
# Opcional: URL pública do webhook, se diferente de NEXT_PUBLIC_APP_URL/api/webhooks/pix.
PAYMENT_WEBHOOK_URL=
